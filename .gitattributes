# Auto detect text files and perform LF normalization
* text=auto

# Ensure Windows batch scripts maintain CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code files
*.go text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.dll binary
*.exe binary
*.ico binary
*.png binary
*.jpg binary
